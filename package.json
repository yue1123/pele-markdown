{
  "name": "pele-markdown",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:update": "vitest run packages/markdown-it-pele -u && vitest run",
    "test:watch": "vitest",
    "test:dist": "pnpm build && node scripts/smoke-dist.mjs",
    "coverage": "vitest run --coverage",
    "typecheck": "pnpm -r run typecheck && tsc -p .",
    "changeset": "changeset",
    "release": "pnpm test && pnpm test:dist && changeset publish",
    "example:vitepress": "pnpm build && pnpm --filter example-vitepress docs:dev",
    "example:playground": "pnpm build && pnpm --filter example-playground dev"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
