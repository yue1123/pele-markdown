{
  "name": "pele-markdown",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck && tsc -p .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
