{
  "name": "marked-pele",
  "version": "0.0.0",
  "description": "marked extension for pele fenced code blocks",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pele",
    "marked"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "pele-markdown-core": "workspace:^"
  },
  "peerDependencies": {
    "marked": ">=13"
  },
  "devDependencies": {
    "marked": "^18.1.1"
  }
}
