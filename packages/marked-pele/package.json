{
  "name": "marked-pele",
  "version": "1.0.0",
  "description": "marked extension that renders Mermaid diagrams to SVG at build time, no client-side JS",
  "keywords": [
    "mermaid",
    "diagram",
    "svg",
    "flowchart",
    "sequence-diagram",
    "ssr",
    "static-site",
    "pele",
    "marked",
    "marked-extension",
    "mermaid-js",
    "diagrams",
    "markdown-plugin",
    "inline-svg",
    "build-time",
    "server-side-rendering",
    "no-js",
    "marked-plugin"
  ],
  "homepage": "https://github.com/yue1123/pele-markdown/tree/main/packages/marked-pele#readme",
  "bugs": "https://github.com/yue1123/pele-markdown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yue1123/pele-markdown.git",
    "directory": "packages/marked-pele"
  },
  "author": {
    "name": "yue1123",
    "url": "https://github.com/yue1123"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@pele-markdown/core": "workspace:^"
  },
  "peerDependencies": {
    "marked": ">=13"
  },
  "devDependencies": {
    "marked": "^18.1.1"
  }
}
