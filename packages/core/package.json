{
  "name": "pele-markdown-core",
  "version": "0.0.0",
  "description": "Render Mermaid diagram code blocks to SVG at build time, shared by markdown-it-pele, marked-pele and remark-pele",
  "keywords": [
    "mermaid",
    "diagram",
    "svg",
    "flowchart",
    "sequence-diagram",
    "ssr",
    "static-site",
    "pele",
    "markdown"
  ],
  "homepage": "https://github.com/yue1123/pele-markdown/tree/main/packages/core#readme",
  "bugs": "https://github.com/yue1123/pele-markdown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yue1123/pele-markdown.git",
    "directory": "packages/core"
  },
  "author": "yue1123",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "pele": "^1.9.0"
  }
}
