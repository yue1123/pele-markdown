{
  "name": "@pele-markdown/core",
  "version": "1.0.1",
  "description": "Render Mermaid diagram code blocks to SVG at build time, shared by markdown-it-pele, marked-pele and remark-pele",
  "keywords": [
    "mermaid",
    "diagram",
    "svg",
    "flowchart",
    "sequence-diagram",
    "ssr",
    "static-site",
    "pele",
    "markdown",
    "mermaid-js",
    "diagrams",
    "markdown-plugin",
    "inline-svg",
    "build-time",
    "server-side-rendering",
    "no-js"
  ],
  "homepage": "https://github.com/yue1123/pele-markdown/tree/main/packages/core#readme",
  "bugs": "https://github.com/yue1123/pele-markdown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yue1123/pele-markdown.git",
    "directory": "packages/core"
  },
  "author": {
    "name": "yue1123",
    "url": "https://github.com/yue1123"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "pele": "^1.9.0"
  }
}
