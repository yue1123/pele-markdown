{
  "name": "remark-pele",
  "version": "1.0.0",
  "description": "remark plugin that renders Mermaid diagrams to SVG at build time, no client-side JS",
  "keywords": [
    "mermaid",
    "diagram",
    "svg",
    "flowchart",
    "sequence-diagram",
    "ssr",
    "static-site",
    "pele",
    "remark",
    "remark-plugin",
    "unified",
    "mdast",
    "mermaid-js",
    "diagrams",
    "markdown-plugin",
    "inline-svg",
    "build-time",
    "server-side-rendering",
    "no-js",
    "rehype"
  ],
  "homepage": "https://github.com/yue1123/pele-markdown/tree/main/packages/remark-pele#readme",
  "bugs": "https://github.com/yue1123/pele-markdown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yue1123/pele-markdown.git",
    "directory": "packages/remark-pele"
  },
  "author": {
    "name": "yue1123",
    "url": "https://github.com/yue1123"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "@pele-markdown/core": "workspace:^",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "unified": ">=11"
  },
  "devDependencies": {
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  }
}
